{
  "manifest_version": 3,
  "name": "MisterTube",
  "version": "1.0.0",
  "description": "Enhanced YouTube experience with history management and UI improvements",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [{
    "resources": [
      "icons/*.png",
      "styles.css"
    ],
    "matches": ["*://*.youtube.com/*"]
  }],
  "background": {
    "service_worker": "background.js"
  }
}